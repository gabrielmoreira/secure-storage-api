{
  "compilerOptions": {
    "target": "ES2024",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": true,
    "strict": false,
    "allowJs": false,
    "allowImportingTsExtensions": true,
    "types": ["node"],
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "secure-storage-api": ["../secure-storage-api/src/index.ts"]
    }
  },
  "include": [
    "src/**/*.ts",
    "test/**/*.ts"
  ]
}